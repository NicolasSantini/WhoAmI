{
  "name": "whoami",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node -e \"require('node:fs').rmSync('node_modules/.astro',{recursive:true,force:true})\"",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "new-race": "node scripts/new-race.ts",
    "build-race": "node scripts/build-race.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "fast-xml-parser": "5.11.2",
    "fit-file-parser": "6.2.7",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
