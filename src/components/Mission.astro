---
import type { CollectionEntry } from 'astro:content';
import { formatRange } from '../lib/format.ts';
import Stat from './Stat.astro';

interface Props {
  entry: CollectionEntry<'experience'>;
  index: number;
}

const { entry, index } = Astro.props;
const { data, id } = entry;
const logId = `log-${id}`;
const { pipeline, rails, matrix } = data;
const hasVisual = pipeline.length > 0 || rails !== undefined || matrix !== undefined;
const matrixColumns = matrix
  ? typeof matrix.columns === 'number'
    ? Array.from({ length: matrix.columns }, () => '')
    : matrix.columns
  : [];
---

<article class="hs-card panel mission">
  <p class="kicker">
    Missione {index + 1}
    <span class:list={['badge', { live: !data.end }]}>{data.end ? 'Completata' : 'In corso'}</span>
  </p>
  <h3>{data.company}</h3>
  <p class="mission-role">{data.role}</p>
  <p class="when">
    {formatRange(data.start, data.end)}
    {data.engagement && ` · ${data.engagement}`}
  </p>
  {/* La parte visiva racconta già il riassunto, che resta nel log. */}
  {!hasVisual && <p class="small">{data.summary}</p>}
  {data.highlights.length > 0 && (
    <div class="stats">
      {data.highlights.map((item) => (
        <Stat value={item.value} label={item.label} />
      ))}
    </div>
  )}
  {pipeline.length > 0 && (
    <>
      <p class="visual-title">Mappa della pipeline</p>
      <ol class="pipeline">
        {pipeline.map((step) => (
          <li>
            <strong>{step.stage}</strong>
            <span>{step.detail}</span>
          </li>
        ))}
      </ol>
    </>
  )}
  {rails && (
    <>
      <p class="visual-title">Doppio binario</p>
      <div class="rails">
        {[rails.from, rails.to].map((rail, i) => (
          <div class:list={['rail', i === 0 ? 'rail-from' : 'rail-to']}>
            <strong>{rail.name}</strong>
            <span>{rail.detail}</span>
            <i class="rail-track" aria-hidden="true"></i>
          </div>
        ))}
        <p class="rail-check">{rails.check}</p>
        <p class="rail-cutover">{rails.cutover}</p>
      </div>
    </>
  )}
  {matrix && (
    <>
      <p class="visual-title">Matrice del percorso</p>
      <div class="matrix">
        <div class="matrix-row matrix-head">
          <span></span>
          {typeof matrix.columns === 'number' ? (
            <span class="matrix-cells">
              {matrix.columns} {matrix.columnsLabel}
            </span>
          ) : (
            <span class="matrix-cells">
              {matrix.columns.map((column) => (
                <span>{column}</span>
              ))}
            </span>
          )}
        </div>
        {matrix.rows.map((row) => (
          <div class="matrix-row">
            <span>{row}</span>
            <span class="matrix-cells" aria-hidden="true">
              {matrixColumns.map(() => (
                <i></i>
              ))}
            </span>
          </div>
        ))}
      </div>
    </>
  )}
  <button class="button ghost" type="button" popovertarget={logId}>
    Apri il log
  </button>

  <div class="log panel" id={logId} popover>
    <button
      class="button ghost log-close"
      type="button"
      popovertarget={logId}
      popovertargetaction="hide"
    >
      Chiudi
    </button>
    <h4>
      {data.role} · {data.company}
    </h4>
    <p class="when">{formatRange(data.start, data.end)}</p>
    <p>{data.summary}</p>
    {data.sections.map((section) => (
      <>
        {section.title && <h5>{section.title}</h5>}
        <ul>
          {section.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </>
    ))}
  </div>
</article>
