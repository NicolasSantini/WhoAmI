---
import { cloud, ridge, SCENE_HEIGHT, SCENE_WIDTH, stars, towers } from '../lib/scene.ts';

interface Props {
  variant: 'city' | 'coast';
}

const { variant } = Astro.props;
const viewBox = `0 0 ${SCENE_WIDTH} ${SCENE_HEIGHT}`;
const groundY = 232;
const city = variant === 'city';
const sky = stars(city ? 7 : 19, city ? 90 : 46, 130);
const clouds = [
  { className: 'cloud-a', x: 404, y: 22, width: 64 },
  { className: 'cloud-b', x: 300, y: 58, width: 88 },
  { className: 'cloud-c', x: 212, y: 12, width: 48 },
];
const buildings = towers(23, groundY);
---

<div class:list={['scene', `scene-${variant}`]} aria-hidden="true">
  <svg class="layer d1" viewBox={viewBox} preserveAspectRatio="xMidYMax slice">
    {sky.map(({ x, y, size, twinkle }) => (
      <rect class:list={{ twinkle }} {x} {y} width={size} height={size} />
    ))}
  </svg>
  <svg class="layer d2 sun" viewBox={viewBox} preserveAspectRatio="xMidYMax slice">
    <rect x="212" y="84" width="56" height="8"></rect>
    <rect x="196" y="92" width="88" height="8"></rect>
    <rect x="184" y="100" width="112" height="8"></rect>
    <rect x="176" y="112" width="128" height="8"></rect>
    <rect x="172" y="124" width="136" height="8"></rect>
    <rect x="172" y="138" width="136" height="6"></rect>
    <rect x="176" y="150" width="128" height="6"></rect>
    <rect x="184" y="162" width="112" height="4"></rect>
  </svg>
  {clouds.map(({ className, x, y, width }) => (
    <svg
      class:list={['layer d3 clouds', className]}
      viewBox={viewBox}
      preserveAspectRatio="xMidYMax slice"
    >
      {cloud(width).map((row) => (
        <rect x={x + row.x} y={y + row.y} width={row.width} height={row.height} />
      ))}
    </svg>
  ))}
  <svg class="layer d4 far" viewBox={viewBox} preserveAspectRatio="xMidYMax slice">
    <path d={ridge(city ? 11 : 31, 196, 92, 4, 3)}></path>
  </svg>
  <svg class="layer d5 near" viewBox={viewBox} preserveAspectRatio="xMidYMax slice">
    {city && <path d={ridge(5, 226, 46, 4, 5)} />}
    {city &&
      buildings.map(({ x, y, width, height }) => <rect class="tower" {x} {y} {width} {height} />)}
    {city &&
      buildings.flatMap(({ leds }) =>
        leds.map(({ x, y, tone }, index) => (
          <rect
            class:list={[`led led-${tone}`, { blink: index % 7 === 0 }]}
            {x}
            {y}
            width="2"
            height="2"
          />
        )),
      )}
    {!city && (
      <>
        <path class="hills" d={ridge(43, 214, 44, 4, 4)} />
        <rect class="sea" x="0" y="206" width={SCENE_WIDTH} height="26" />
        <rect class="wave" x="30" y="212" width="46" height="2" />
        <rect class="wave" x="150" y="218" width="70" height="2" />
        <rect class="wave" x="300" y="212" width="52" height="2" />
        <rect class="wave" x="396" y="222" width="58" height="2" />
      </>
    )}
  </svg>
  <svg class="layer d6 ground" viewBox={viewBox} preserveAspectRatio="xMidYMax slice">
    <rect x="0" y={groundY} width={SCENE_WIDTH} height={SCENE_HEIGHT - groundY}></rect>
  </svg>
</div>
