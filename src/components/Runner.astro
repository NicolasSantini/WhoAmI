  '.....s..s.....',
  '.....s..s.....',
  '.....s..s.....',
  '....oo..oo....',
];
const pixels = (rows: string[]) =>
  rows.flatMap((row, y) =>
    [...row].flatMap((color, x) => (color === '.' ? [] : [{ x, y, color }])),
  );
const sprites = [...frames.map(pixels), pixels(idle)];
---

<svg
  class={portrait ? 'player-sprite' : 'runner'}
  data-runner={portrait ? undefined : ''}
  data-frame="4"
  viewBox="0 0 14 15"
  aria-hidden="true"
  shape-rendering="crispEdges"
>
  {sprites.map((sprite, frame) => (
    <g class={`frame frame-${frame}`}>
      {sprite.map(({ x, y, color }) => (
        <rect class={`c-${color}`} {x} {y} width="1" height="1" />
      ))}
    </g>
  ))}
</svg>
