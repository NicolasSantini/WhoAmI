  rows.flatMap((row, y) =>
    [...row].flatMap((color, x) => (color === '.' ? [] : [{ x, y, color }])),
  );
const sports = {
  swim: [...swim, swimIdle],
  bike: [...bike, pedalsLevel],
  run: [...run, runIdle].map(widen),
};
// The portrait is always the runner, cropped back to its own width.
const shown = portrait ? (['run'] as const) : (['swim', 'bike', 'run'] as const);
---

<svg
  class={portrait ? 'player-sprite' : 'runner'}
  data-runner={portrait ? undefined : ''}
  data-frame="4"
  data-sport={portrait ? 'run' : 'swim'}
  viewBox={portrait ? '3 0 14 15' : '0 0 20 15'}
  aria-hidden="true"
  shape-rendering="crispEdges"
>
  {shown.map((sport) => (
    <g class={`sport sport-${sport}`}>
      {sports[sport].map(pixels).map((sprite, frame) => (
        <g class={`frame frame-${frame}`}>
          {sprite.map(({ x, y, color }) => (
            <rect class={`c-${color}`} {x} {y} width="1" height="1" />
          ))}
        </g>
      ))}
    </g>
  ))}
</svg>
