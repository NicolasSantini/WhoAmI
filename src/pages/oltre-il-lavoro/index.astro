---
import { getCollection } from 'astro:content';
import RaceReel from '../../components/RaceReel.astro';
import Scene from '../../components/Scene.astro';
import Stat from '../../components/Stat.astro';
import XpBar from '../../components/XpBar.astro';
import Base from '../../layouts/Base.astro';
import { getRaces, raceDateLabel } from '../../lib/races.ts';
import { characterSheet } from '../../lib/stats.ts';

const races = await getRaces();
const upcoming = races.filter(({ data }) => data.status === 'upcoming');
const done = races.filter(({ data }) => data.status === 'done').reverse();
const roadmap = races.filter(({ data }) => data.roadmap);
const training = await getCollection('training');
const journey = (await getCollection('journey')).sort((a, b) => a.data.order - b.data.order);
const sheet = characterSheet(
  races.map(({ data }) => data),
  training.map(({ data }) => data),
);
const isoDate = (date?: Date) => date?.toISOString().slice(0, 10);

const chapters = [
  { id: 'scheda', label: 'Scheda personaggio' },
  { id: 'percorso', label: 'Il mio percorso' },
  { id: 'prossime', label: 'Prossime gare' },
  { id: 'ironman', label: "Verso l'Ironman" },
  { id: 'gare', label: 'Gare fatte' },
];
---

<Base
  title="Oltre il lavoro"
  description="Il percorso sportivo di Nicolas Santini: gare fatte, prossimi obiettivi e la strada verso l'Ironman di Cervia."
  chapters={chapters}
>
  <section class="hero" data-progress data-chapter="Livello bonus" data-world="start">
    <div class="hero-sticky">
      <Scene variant="coast" />
      <div class="hero-copy wrap">
        <p class="kicker">Livello bonus</p>
        <h1>
          Oltre il
          <br />
          lavoro
        </h1>
        <p class="lead">
          Un ingegnere che tratta il proprio corpo come un progetto a lungo termine: misurato,
          iterato e spinto un po' più in là a ogni gara.
        </p>
      </div>
      <a class="press-start" href="#scheda">
        Scorri per partire
      </a>
    </div>
  </section>

  <section class="chapter" id="scheda" data-chapter="Scheda personaggio" data-world="player">
    <div class="wrap">
      <div class="chapter-head" data-reveal="left">
        <p class="kicker">Multisport amatore · Livello {sheet.overall.level}</p>
        <h2>Scheda personaggio</h2>
      </div>
      <div class="panel" data-reveal="pop">
        <div class="stats">
          <Stat value={String(Math.round(sheet.totals.km))} label="km" />
          <Stat value={String(sheet.totals.elevation)} label="metri di dislivello" />
          <Stat value={String(sheet.totals.races)} label="gare" />
          <Stat value={String(sheet.totals.medals)} label="medaglie" />
        </div>
        <XpBar label="Nuoto" tone="swim" stats={sheet.disciplines.swim} />
        <XpBar label="Bici" tone="bike" stats={sheet.disciplines.bike} />
        <XpBar label="Corsa" tone="run" stats={sheet.disciplines.run} />
      </div>
    </div>
  </section>

  <section class="chapter" id="percorso" data-chapter="Il mio percorso" data-world="missions">
    <div class="wrap">
      <div class="chapter-head" data-reveal="left">
        <p class="kicker">La mappa</p>
        <h2>Il mio percorso</h2>
      </div>
      <ol class="path">
        {journey.map(({ data }, index) => (
          <li data-reveal={index % 2 ? 'right' : 'left'}>
            <div class="panel">
              <p class="kicker">{data.when}</p>
              <h3>{data.title}</h3>
              <p class="small">{data.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="hs" id="prossime" data-hscroll data-chapter="Prossime gare" data-world="coop">
    <div class="hs-sticky">
      <div class="hs-head">
        <p class="kicker">Selezione livello</p>
        <h2>Prossime gare</h2>
        <p class="hs-counter" data-hs-counter aria-hidden="true"></p>
      </div>
      <div class="hs-track">
        {upcoming.map(({ data }) => (
          <article class:list={['hs-card panel level', { boss: data.finalGoal }]}>
            <p class="kicker">{data.finalGoal ? 'Boss finale' : data.kind}</p>
            <h3>{data.title}</h3>
            <p class="when">
              {raceDateLabel(data)}
              {data.location && ` · ${data.location}`}
            </p>
            {data.goal && <p class="small">{data.goal}</p>}
            {data.date && (
              <p
                class="countdown"
                data-countdown={isoDate(data.date)}
                data-approximate={data.dateConfirmed ? undefined : ''}
                hidden
              />
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="chapter" id="ironman" data-chapter="Verso l'Ironman" data-world="trophies">
    <div class="wrap">
      <div class="chapter-head" data-reveal="left">
        <p class="kicker">Quest principale</p>
        <h2>Verso l'Ironman</h2>
      </div>
      <div class="panel prose" data-reveal="pop">
        <ol class="quest">
          {roadmap.map(({ data }) => (
            <li
              class:list={{
                'is-done': data.status === 'done',
                'is-final': data.finalGoal,
              }}
            >
              <span class="quest-mark" aria-hidden="true" />
              <span>
                {data.title}
                <span class="muted small">
                  {' · '}
                  {data.status === 'done' ? 'fatta' : raceDateLabel(data)}
                </span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="hs" id="gare" data-hscroll data-chapter="Gare fatte" data-world="quest">
    <div class="hs-sticky">
      <div class="hs-head">
        <p class="kicker">Sala trofei</p>
        <h2>Gare fatte</h2>
        <p class="hs-counter" data-hs-counter aria-hidden="true"></p>
      </div>
      <div class="hs-track">
        <RaceReel races={done} />
      </div>
    </div>
  </section>

  <section class="chapter ending" data-chapter="Fine del livello" data-world="end">
    <div class="wrap" data-reveal="pop">
      <h2>Continua?</h2>
      <div class="actions">
        <a class="button" href="/">
          Torna al lavoro
        </a>
      </div>
    </div>
  </section>
</Base>

<script src="../../scripts/countdown.ts"></script>
