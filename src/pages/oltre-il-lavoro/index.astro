---
import '../../styles/sport.css';
import { getCollection } from 'astro:content';
import Medal from '../../components/Medal.astro';
import PixelTrophy from '../../components/PixelTrophy.astro';
import XpBar from '../../components/XpBar.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, formatNumber, formatTime } from '../../lib/format.ts';
import { getRaces, raceDateLabel } from '../../lib/races.ts';
import { characterSheet, raceDistance, racePace, raceTime } from '../../lib/stats.ts';

const races = await getRaces();
const upcoming = races.filter(({ data }) => data.status === 'upcoming');
const done = races.filter(({ data }) => data.status === 'done').reverse();
const roadmap = races.filter(({ data }) => data.roadmap);
const training = await getCollection('training');
const journey = (await getCollection('journey')).sort((a, b) => a.data.order - b.data.order);
const sheet = characterSheet(
  races.map(({ data }) => data),
  training.map(({ data }) => data),
);
const isoDate = (date?: Date) => date?.toISOString().slice(0, 10);
---

<Base
  title="Oltre il lavoro"
  description="Il percorso sportivo di Nicolas Santini: gare fatte, prossimi obiettivi e la strada verso l'Ironman di Cervia."
>
  <div class="wrap page sport">
    <h1>Oltre il lavoro</h1>
    <p class="lead">
      Un ingegnere che tratta il proprio corpo come un progetto a lungo termine: misurato, iterato e
      spinto un po' più in là a ogni gara, fino all'Ironman di Cervia.
    </p>

    <section class="sheet" aria-labelledby="scheda">
      <div class="sheet-head">
        <h2 id="scheda">Scheda personaggio</h2>
        <span class="sheet-class">Multisport amatore · Livello {sheet.overall.level}</span>
      </div>
      <dl class="sheet-stats">
        <div>
          <dt>Km</dt>
          <dd>{formatNumber(sheet.totals.km)}</dd>
        </div>
        <div>
          <dt>Dislivello</dt>
          <dd>{formatNumber(sheet.totals.elevation)} m</dd>
        </div>
        <div>
          <dt>Gare</dt>
          <dd>{sheet.totals.races}</dd>
        </div>
        <div>
          <dt>Medaglie</dt>
          <dd>{sheet.totals.medals}</dd>
        </div>
      </dl>
      <XpBar label="Nuoto" tone="swim" stats={sheet.disciplines.swim} />
      <XpBar label="Bici" tone="bike" stats={sheet.disciplines.bike} />
      <XpBar label="Corsa" tone="run" stats={sheet.disciplines.run} />
    </section>

    <h2>Il mio percorso</h2>
    <ol class="timeline">
      {journey.map(({ data }) => (
        <li>
          <span class="when">{data.when}</span>
          <h3>{data.title}</h3>
          <p class="prose">{data.text}</p>
        </li>
      ))}
    </ol>

    <h2>Prossime gare</h2>
    <ul class="race-grid">
      {upcoming.map(({ data }) => (
        <li>
          <h3>{data.title}</h3>
          <p class="muted small">
            {raceDateLabel(data)}
            {data.location && ` · ${data.location}`}
          </p>
          {data.goal && <p class="race-goal small">{data.goal}</p>}
          {data.date && (
            <p
              class="countdown"
              data-countdown={isoDate(data.date)}
              data-approximate={data.dateConfirmed ? undefined : ''}
              hidden
            />
          )}
        </li>
      ))}
    </ul>

    <h3>Verso l'Ironman</h3>
    <ol class="quest">
      {roadmap.map(({ data }) => (
        <li
          class:list={{
            'is-done': data.status === 'done',
            'is-final': data.finalGoal,
          }}
        >
          <span class="quest-mark" aria-hidden="true" />
          <span>
            {data.title}
            <span class="muted small">
              {' · '}
              {data.status === 'done' ? 'fatta' : raceDateLabel(data)}
            </span>
          </span>
        </li>
      ))}
    </ol>

    <h2>Gare fatte</h2>
    <ul class="race-grid">
      {done.map(({ id, data }) => (
        <li class="trophy">
          <div class="trophy-top">
            <div>
              <h3>{data.title}</h3>
              <p class="muted small">
                {data.date && formatDate(data.date)}
                {data.location && ` · ${data.location}`}
              </p>
            </div>
            {data.auto?.medal ? (
              <Medal compact front={data.auto.medal.front} alt="" />
            ) : (
              <PixelTrophy />
            )}
          </div>
          {raceTime(data) && <p class="trophy-time">{formatTime(raceTime(data) ?? '')}</p>}
          <p class="small muted">
            {raceDistance(data) && `${formatNumber(raceDistance(data) ?? 0, 1)} km`}
            {racePace(data) && ` · ${racePace(data)}`}
          </p>
          <a href={`/oltre-il-lavoro/gare/${id}/`}>Dettagli della gara</a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<script src="../../scripts/countdown.ts"></script>
