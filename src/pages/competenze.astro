---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const groups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Competenze"
  description="Competenze di Nicolas Santini: Google Cloud, pipeline dati, Python, SQL, database, AWS e AI generativa."
>
  <div class="wrap page">
    <h1>Competenze</h1>
    <ul class="cards">
      {groups.map(({ data }) => (
        <li>
          <h2>{data.group}</h2>
          <ul class="tags">
            {data.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</Base>
